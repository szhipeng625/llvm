# raft 分布式共识模块 —— Windows 运行时实测
#
# 走的是内置模块调用写法 raft.build(...)，irgen 把它映射到运行时 DLL 里的
# py_raft_build_v。raft.cpp 本身不碰 socket（选举是模拟的），所以它是
# 移植回 Windows 后第一个能真正跑起来的分布式模块。

print("=== raft 模块实测 ===")

cfg = "{\"node_id\":\"node1\",\"bind_addr\":\"127.0.0.1:9000\"}"
node = raft.build(cfg)
print("build:", node)

st = raft.status("node1")
print("status:", st)

nodes = raft.list_nodes()
print("list_nodes:", nodes)

raft.register_node("node1", "follower", "127.0.0.1:9001")
print("cluster_nodes:", raft.cluster_nodes("node1"))

print("mount:", raft.mount_storage("node1", "kv", "./raft_data/kv"))

print("=== 等待单节点选举 ===")
sleep_ms(1000)

st2 = raft.status("node1")
print("status after election:", st2)

leader = raft.leader_info("node1")
print("leader_info:", leader)

print("=== 结束 ===")
