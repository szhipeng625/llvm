# 红黑树。
#
# 红黑树是一种自平衡二叉搜索树,靠"节点着色 + 旋转"维持平衡。
# 它保证五条性质,其中最关键的两条:
#   1. 红节点的两个孩子都必须是黑的(不存在连续两个红节点)
#   2. 从任一节点到其所有后代空位的路径上,黑节点数目相同
# 由这两条可推出:最长路径不超过最短路径的两倍,树高是 O(log n)。
#
# 这里用一个"哨兵空节点"代替 None:所有叶子的空位都指向同一个黑色哨兵。
# 好处是删除时"把空位接入树"不需要特判空指针 —— 空位本身也有 parent,
# 调整程序可以照常沿 parent 回溯。
#
# 支持:插入、查找、删除,以及两条核心性质的校验。

class RBNode:
    def __init__(self, key, val):
        self.key = key
        self.val = val
        self.red = True
        self.left = None
        self.right = None
        self.parent = None

class RBTree:
    def __init__(self):
        self.nil = RBNode(0, 0)
        self.nil.red = False
        self.nil.left = self.nil
        self.nil.right = self.nil
        self.nil.parent = self.nil
        self.root = self.nil
        self.count = 0

    # --- 旋转 ---
    def left_rotate(self, x):
        y = x.right
        x.right = y.left
        if y.left != self.nil:
            y.left.parent = x
        y.parent = x.parent
        if x.parent == self.nil:
            self.root = y
        elif x == x.parent.left:
            x.parent.left = y
        else:
            x.parent.right = y
        y.left = x
        x.parent = y

    def right_rotate(self, x):
        y = x.left
        x.left = y.right
        if y.right != self.nil:
            y.right.parent = x
        y.parent = x.parent
        if x.parent == self.nil:
            self.root = y
        elif x == x.parent.left:
            x.parent.left = y
        else:
            x.parent.right = y
        y.right = x
        x.parent = y

    # --- 插入 ---
    def insert(self, key, val):
        z = RBNode(key, val)
        z.left = self.nil
        z.right = self.nil
        y = self.nil
        x = self.root
        while x != self.nil:
            y = x
            if key < x.key:
                x = x.left
            elif key > x.key:
                x = x.right
            else:
                x.val = val
                return False
        z.parent = y
        if y == self.nil:
            self.root = z
        elif key < y.key:
            y.left = z
        else:
            y.right = z
        z.red = True
        self.count = self.count + 1
        self.fix_after_insert(z)
        return True

    # 插入后的调整:只在"父红"时才有事可做,一路向树根回溯
    def fix_after_insert(self, z):
        while z.parent.red:
            if z.parent == z.parent.parent.left:
                u = z.parent.parent.right
                if u.red:
                    z.parent.red = False
                    u.red = False
                    z.parent.parent.red = True
                    z = z.parent.parent
                else:
                    if z == z.parent.right:
                        z = z.parent
                        self.left_rotate(z)
                    z.parent.red = False
                    z.parent.parent.red = True
                    self.right_rotate(z.parent.parent)
            else:
                u = z.parent.parent.left
                if u.red:
                    z.parent.red = False
                    u.red = False
                    z.parent.parent.red = True
                    z = z.parent.parent
                else:
                    if z == z.parent.left:
                        z = z.parent
                        self.right_rotate(z)
                    z.parent.red = False
                    z.parent.parent.red = True
                    self.left_rotate(z.parent.parent)
        self.root.red = False

    # --- 查找 ---
    def find_node(self, key):
        x = self.root
        while x != self.nil:
            if key == x.key:
                return x
            if key < x.key:
                x = x.left
            else:
                x = x.right
        return self.nil

    def get(self, key):
        n = self.find_node(key)
        if n == self.nil:
            return None
        return n.val

    def has(self, key):
        return self.find_node(key) != self.nil

    # --- 删除 ---
    def delete(self, key):
        z = self.find_node(key)
        if z == self.nil:
            return False
        self.delete_node(z)
        self.count = self.count - 1
        return True

    # 用 v 顶替 u 的位置(v 可以是哨兵)
    def transplant(self, u, v):
        if u.parent == self.nil:
            self.root = v
        elif u == u.parent.left:
            u.parent.left = v
        else:
            u.parent.right = v
        v.parent = u.parent

    def minimum(self, n):
        while n.left != self.nil:
            n = n.left
        return n

    def delete_node(self, z):
        y = z
        y_red = y.red
        if z.left == self.nil:
            x = z.right
            self.transplant(z, z.right)
        elif z.right == self.nil:
            x = z.left
            self.transplant(z, z.left)
        else:
            y = self.minimum(z.right)
            y_red = y.red
            x = y.right
            if y.parent == z:
                x.parent = y
            else:
                self.transplant(y, y.right)
                y.right = z.right
                y.right.parent = y
            self.transplant(z, y)
            y.left = z.left
            y.left.parent = y
            y.red = z.red
        if not y_red:
            self.fix_after_delete(x)

    # 删除后的调整:被删/被移走的是黑节点才会破坏黑高,需要补齐
    def fix_after_delete(self, x):
        while x != self.root and not x.red:
            if x == x.parent.left:
                w = x.parent.right
                if w.red:
                    w.red = False
                    x.parent.red = True
                    self.left_rotate(x.parent)
                    w = x.parent.right
                if not w.left.red and not w.right.red:
                    w.red = True
                    x = x.parent
                else:
                    if not w.right.red:
                        w.left.red = False
                        w.red = True
                        self.right_rotate(w)
                        w = x.parent.right
                    w.red = x.parent.red
                    x.parent.red = False
                    w.right.red = False
                    self.left_rotate(x.parent)
                    x = self.root
            else:
                w = x.parent.left
                if w.red:
                    w.red = False
                    x.parent.red = True
                    self.right_rotate(x.parent)
                    w = x.parent.left
                if not w.left.red and not w.right.red:
                    w.red = True
                    x = x.parent
                else:
                    if not w.left.red:
                        w.right.red = False
                        w.red = True
                        self.left_rotate(w)
                        w = x.parent.left
                    w.red = x.parent.red
                    x.parent.red = False
                    w.left.red = False
                    self.right_rotate(x.parent)
                    x = self.root
        x.red = False

    # --- 遍历与校验 ---
    def inorder(self):
        out = []
        self.walk(self.root, out)
        return out

    def walk(self, n, out):
        if n == self.nil:
            return
        self.walk(n.left, out)
        out.append(n.key)
        self.walk(n.right, out)

    # 校验红黑树性质:根必须黑、根的父亲是哨兵、两条核心性质成立
    def check_props(self):
        if self.root.red:
            return False
        if self.root == self.nil:
            return True
        if self.root.parent != self.nil:
            return False
        return self.black_height(self.root) > 0

    # 返回黑高;发现违规返回 0(正常树的黑高至少为 1)
    def black_height(self, n):
        if n == self.nil:
            return 1
        lh = self.black_height(n.left)
        rh = self.black_height(n.right)
        if lh == 0 or rh == 0 or lh != rh:
            return 0
        if n.red and (n.left.red or n.right.red):
            return 0
        if n.red:
            return lh
        return lh + 1

    def height(self):
        return self.h_of(self.root)

    def h_of(self, n):
        if n == self.nil:
            return 0
        a = self.h_of(n.left)
        b = self.h_of(n.right)
        if a > b:
            return a + 1
        return b + 1

# --- 自测 ---
t = RBTree()
for k in [10, 20, 30, 15, 25, 5, 1, 40, 50, 35, 45, 33, 37, 28, 22]:
    t.insert(k, k * k)
print(t.count)
print(t.inorder())
print(t.height())
print(t.check_props())
print(t.get(25))
print(t.get(999))
print(t.has(37))

for k in [10, 30, 1, 50, 25, 33]:
    t.delete(k)
print(t.count)
print(t.inorder())
print(t.check_props())
print(t.height())

for k in [20, 15, 5, 40, 35, 45, 37, 28, 22]:
    t.delete(k)
print(t.count)
print(t.inorder())
print(t.check_props())
print(t.delete(999))
