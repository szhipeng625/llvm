# 容器、字符串、循环与复合赋值
xs = [1, 2, 3]
xs.append(4)
print(xs[0], xs[3])

d = {"a": 1, "b": 2}
print(d["a"])

s = "hello"
print(s.upper())
print(s[1:3])

i = 0
while i < 3:
    if i == 1:
        i += 1
        continue
    print(i)
    i += 1

for x in xs:
    if x > 3:
        break
    print(x)

print(2 ** 10)
print(7 // 2, 7 % 2, 7 / 2)
print(not True, 1 < 2 and 3 > 2)
print(-2 ** 2)
