From 2933adcf3ae22523f3ce53af8389a9f50474c3ea Mon Sep 17 00:00:00 2001
From: PyLite Developer <pylite@example.com>
Date: Fri, 9 Oct 2026 19:55:38 +0800
Subject: [PATCH] fix: use PROJECT_SOURCE_DIR for submodule compatibility;
 guard test/tools dirs for non-toplevel build

---
 CMakeLists.txt             | 12 +++++++-----
 src/CMakeLists.txt         |  4 ++--
 src/catalog/CMakeLists.txt |  4 ++--
 src/sdk/CMakeLists.txt     |  2 +-
 src/storage/CMakeLists.txt |  4 ++--
 src/topo/CMakeLists.txt    |  4 ++--
 6 files changed, 16 insertions(+), 14 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f5e0ef5..ebab108 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -73,10 +73,10 @@ find_package(GTest CONFIG REQUIRED)
 
 set(ADVISKV_GENERATED_DIR ${PROJECT_BINARY_DIR}/generated)
 set(ADVISKV_PROTO_FILES
-    ${CMAKE_SOURCE_DIR}/proto/common.proto
-    ${CMAKE_SOURCE_DIR}/proto/storage.proto
-    ${CMAKE_SOURCE_DIR}/proto/catalog.proto
-    ${CMAKE_SOURCE_DIR}/proto/topo.proto
+    ${PROJECT_SOURCE_DIR}/proto/common.proto
+    ${PROJECT_SOURCE_DIR}/proto/storage.proto
+    ${PROJECT_SOURCE_DIR}/proto/catalog.proto
+    ${PROJECT_SOURCE_DIR}/proto/topo.proto
 )
 
 set(ADVISKV_PROTO_GENERATED_SRCS)
@@ -104,7 +104,7 @@ add_custom_command(
     OUTPUT ${ADVISKV_PROTO_GENERATED}
     COMMAND ${CMAKE_COMMAND} -E make_directory ${ADVISKV_GENERATED_DIR} # 创建生成目录
     COMMAND protobuf::protoc
-    -I ${CMAKE_SOURCE_DIR}/proto # proto import 路径是 proto/ 目录
+    -I ${PROJECT_SOURCE_DIR}/proto # proto import 路径是 proto/ 目录
     --cpp_out=${ADVISKV_GENERATED_DIR}
     --grpc_out=${ADVISKV_GENERATED_DIR}
     --plugin=protoc-gen-grpc=$<TARGET_FILE:gRPC::grpc_cpp_plugin>
@@ -141,9 +141,11 @@ enable_testing()
 set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)
 
 add_subdirectory(src)
+if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
 add_subdirectory(tools/cli)
 add_subdirectory(tools/storage_client)
 add_subdirectory(tools/e2e)
 add_subdirectory(tools/bench)
 add_subdirectory(tools/maelstrom_raft)
 add_subdirectory(test)
+endif()
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 4094dcc..c0c5055 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -7,11 +7,11 @@ add_library(adviskv_common
 )
 
 target_include_directories(adviskv_common PUBLIC
-    ${CMAKE_SOURCE_DIR}/src
+    ${PROJECT_SOURCE_DIR}/src
 )
 
 target_compile_definitions(adviskv_common PUBLIC
-    ADVISKV_PROJECT_ROOT="${CMAKE_SOURCE_DIR}"
+    ADVISKV_PROJECT_ROOT="${PROJECT_SOURCE_DIR}"
 )
 
 
diff --git a/src/catalog/CMakeLists.txt b/src/catalog/CMakeLists.txt
index d65f032..18bd386 100644
--- a/src/catalog/CMakeLists.txt
+++ b/src/catalog/CMakeLists.txt
@@ -25,7 +25,7 @@ target_link_libraries(adviskv_catalog_lib PUBLIC
 )
 
 target_include_directories(adviskv_catalog_lib PUBLIC
-    ${CMAKE_SOURCE_DIR}/src
+    ${PROJECT_SOURCE_DIR}/src
 )
 
 add_library(adviskv_catalog_test_lib
@@ -37,7 +37,7 @@ target_link_libraries(adviskv_catalog_test_lib PUBLIC
 )
 
 target_include_directories(adviskv_catalog_test_lib PUBLIC
-    ${CMAKE_SOURCE_DIR}/src
+    ${PROJECT_SOURCE_DIR}/src
 )
 
 target_compile_definitions(adviskv_catalog_test_lib PUBLIC
diff --git a/src/sdk/CMakeLists.txt b/src/sdk/CMakeLists.txt
index 3fb47c2..a802a27 100644
--- a/src/sdk/CMakeLists.txt
+++ b/src/sdk/CMakeLists.txt
@@ -14,5 +14,5 @@ target_link_libraries(adviskv_sdk PUBLIC
 )
 
 target_include_directories(adviskv_sdk PUBLIC
-    ${CMAKE_SOURCE_DIR}/src
+    ${PROJECT_SOURCE_DIR}/src
 )
\ No newline at end of file
diff --git a/src/storage/CMakeLists.txt b/src/storage/CMakeLists.txt
index de34497..4c33dc8 100644
--- a/src/storage/CMakeLists.txt
+++ b/src/storage/CMakeLists.txt
@@ -47,7 +47,7 @@ target_link_libraries(adviskv_storage_lib PUBLIC
 )
 
 target_include_directories(adviskv_storage_lib PUBLIC
-    ${CMAKE_SOURCE_DIR}/src
+    ${PROJECT_SOURCE_DIR}/src
 )
 
 add_library(adviskv_storage_test_lib
@@ -59,7 +59,7 @@ target_link_libraries(adviskv_storage_test_lib PUBLIC
 )
 
 target_include_directories(adviskv_storage_test_lib PUBLIC
-    ${CMAKE_SOURCE_DIR}/src
+    ${PROJECT_SOURCE_DIR}/src
 )
 
 target_compile_definitions(adviskv_storage_test_lib PUBLIC
diff --git a/src/topo/CMakeLists.txt b/src/topo/CMakeLists.txt
index 6fa1b72..e22466b 100644
--- a/src/topo/CMakeLists.txt
+++ b/src/topo/CMakeLists.txt
@@ -47,7 +47,7 @@ target_link_libraries(adviskv_topo_lib PUBLIC
 )
 
 target_include_directories(adviskv_topo_lib PUBLIC
-    ${CMAKE_SOURCE_DIR}/src
+    ${PROJECT_SOURCE_DIR}/src
 )
 
 add_library(adviskv_topo_test_lib
@@ -59,7 +59,7 @@ target_link_libraries(adviskv_topo_test_lib PUBLIC
 )
 
 target_include_directories(adviskv_topo_test_lib PUBLIC
-    ${CMAKE_SOURCE_DIR}/src
+    ${PROJECT_SOURCE_DIR}/src
 )
 
 target_compile_definitions(adviskv_topo_test_lib PUBLIC
-- 
