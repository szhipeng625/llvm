// 演示:类 + 虚函数 + 继承 + 容器查找实例

class Docker {
  int id;
  string name;
  virtual int run(int x) {
    return x + 1;
  }
  string tag() {
    return "Docker";
  }
}

class JudgeBox extends Docker {
  int limit;
  virtual int run(int x) {
    return x * 100;
  }
  string tag() {
    return "JudgeBox";
  }
}

Docker d = new Docker();
 d.id = 1;
 d.name = "base";
print(d.run(5));
print(d.tag());

JudgeBox b = new JudgeBox();
 b.id = 2;
 b.name = "judge";
b.limit = 1000;
print(b.run(5));
print(b.tag());

// 容器: 存放基类引用, 通过容器找回实例地址并多态调用
vector<Docker> box = new vector<Docker>();
box.push(d);
box.push(b);
print(box.len());

Docker x = box.get(0);
print(x.run(5));
print(x.tag());

Docker y = box.get(1);
print(y.run(5));
print(y.tag());
