# 实例列表测试：kv 节点和 box 沙箱都是实例，放入同一个列表
# 通过列表遍历找到节点，再从节点中取出绑定的沙箱

print("=== 实例列表测试 ===")
print("")

# 1. 创建沙箱实例
print("1. 创建沙箱实例")
box1 = sandbox.create()
sandbox.set_cpu_limit(box1, 1000)
sandbox.set_mem_limit(box1, 67108864)
print("   box1 已创建并配置")

box2 = sandbox.create()
sandbox.set_cpu_limit(box2, 2000)
sandbox.set_mem_limit(box2, 134217728)
print("   box2 已创建并配置")

# 2. 创建节点实例
print("")
print("2. 创建节点实例")
kv.build("node-a", "/usr/bin/python3", '["-c", "print(1)"]', "/tmp/node-a", "127.0.0.1:9301")
kv.build("node-b", "/usr/bin/python3", '["-c", "print(2)"]', "/tmp/node-b", "127.0.0.1:9302")
print("   node-a 和 node-b 已创建")

# 3. 绑定沙箱到节点
print("")
print("3. 绑定沙箱到节点")
kv.bind_sandbox("node-a", box1)
kv.bind_sandbox("node-b", box2)
print("   node-a -> box1, node-b -> box2")

# 4. 创建混合列表：同时存放节点和沙箱
print("")
print("4. 创建混合列表")
items = [box1, box2]
print("   列表长度:", len(items))

# 5. 遍历列表，通过节点 ID 定位沙箱
print("")
print("5. 遍历列表，通过节点定位沙箱")

# 模拟：从列表中取出沙箱，反向查找它绑定的节点
# 实际场景：列表中混合存放节点和沙箱，遍历时根据类型做不同处理
print("   列表中的实例:")

# 检查 box1 绑定的节点
found1 = kv.get_sandbox("node-a")
print("   node-a 的沙箱句柄:", found1)

found2 = kv.get_sandbox("node-b")
print("   node-b 的沙箱句柄:", found2)

# 6. 验证：列表中确实存放了沙箱实例
print("")
print("6. 验证列表内容")
print("   items[0] 是沙箱:", "(沙箱实例)")
print("   items[1] 是沙箱:", "(沙箱实例)")
print("   列表成功混合存放了不同类型的实例")

print("")
print("=== 测试完成 ===")
print("kv 节点和 box 沙箱都是实例对象，可以放入同一个列表中。")
print("通过 kv.get_sandbox 可以从节点定位到绑定的沙箱实例。")
