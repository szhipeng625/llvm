# 分布式节点 + 判题沙箱测试
# 创建判题沙箱，通过 kv.add 添加到分布式节点中

print("=== 分布式节点 + 判题沙箱测试 ===")
print("")

# 1. 创建判题沙箱
print("1. 创建判题沙箱")
box = sandbox.create()
print("   沙箱句柄:", box)

# 2. 配置沙箱参数
print("2. 配置沙箱参数")
sandbox.set_cpu_limit(box, 1000)
print("   CPU 限制: 1000ms")

sandbox.set_mem_limit(box, 67108864)
print("   内存限制: 64MB")

sandbox.set_max_pids(box, 10)
print("   最大进程数: 10")

sandbox.set_work_dir(box, "/tmp/sandbox")
print("   工作目录: /tmp/sandbox")

sandbox.set_binary(box, "/usr/bin/python3")
print("   用户程序: /usr/bin/python3")

sandbox.add_arg(box, "-c")
sandbox.add_arg(box, "print('hello from sandbox')")
print("   参数: -c 'print(...)'")

# 3. 通过 kv.add 将沙箱添加到分布式节点
print("")
print("3. 通过 kv.add 将沙箱添加到分布式节点")

# kv.add(node_id, binary, args_json, work_dir, addr)
# 把沙箱作为节点加入集群
r = kv.add("sandbox-node-1", "/usr/bin/python3", '["-c", "print(42)"]', "/tmp/sandbox", "127.0.0.1:9101")
print("   kv.add 结果:", r)

# 4. 查看节点列表
print("")
print("4. 查看节点列表")
nodes = kv.list()
print("   节点列表:", nodes)

# 5. 检查沙箱节点存活
print("")
print("5. 检查沙箱节点存活")
print("   sandbox-node-1 存活:", kv.alive("sandbox-node-1"))

# 6. 查看沙箱节点状态
print("")
print("6. 查看沙箱节点状态")
print("   sandbox-node-1 状态:", kv.status("sandbox-node-1"))

print("")
print("=== 测试完成 ===")
print("成功创建判题沙箱并通过 kv.add 添加到分布式节点中。")
