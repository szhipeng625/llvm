# 沙箱定位测试：通过节点 ID 查找绑定的沙箱实例
# 模拟 kv-1>box 的语义

print("=== 沙箱定位测试 ===")
print("")

# 1. 创建判题沙箱
print("1. 创建判题沙箱")
box = sandbox.create()
print("   沙箱句柄:", box)

# 配置沙箱
sandbox.set_cpu_limit(box, 1000)
sandbox.set_mem_limit(box, 67108864)
sandbox.set_binary(box, "/usr/bin/python3")
print("   沙箱已配置")

# 2. 创建分布式节点
print("")
print("2. 创建分布式节点")
r = kv.build("judge-node-1", "/usr/bin/python3", '["-c", "print(42)"]', "/tmp/judge", "127.0.0.1:9201")
print("   节点创建:", r)

# 3. 将沙箱绑定到节点（核心：建立 kv-1 → box 的映射）
print("")
print("3. 绑定沙箱到节点 (kv.bind_sandbox)")
result = kv.bind_sandbox("judge-node-1", box)
print("   绑定结果:", result)

# 4. 通过节点 ID 查找沙箱（核心：kv-1>box 的等价操作）
print("")
print("4. 通过节点 ID 查找沙箱 (kv.get_sandbox)")
found = kv.get_sandbox("judge-node-1")
print("   找到的沙箱句柄:", found)
print("   原始沙箱句柄:", box)
print("   匹配:", found == box)

# 5. 查找不存在的节点
print("")
print("5. 查找不存在的节点")
not_found = kv.get_sandbox("nonexistent")
print("   结果:", not_found, "(应为 -1)")

# 6. 解除绑定
print("")
print("6. 解除绑定")
kv.unbind_sandbox("judge-node-1")
print("   已解除绑定")

# 7. 再次查找（应返回 -1）
print("")
print("7. 解除绑定后再次查找")
after = kv.get_sandbox("judge-node-1")
print("   结果:", after, "(应为 -1)")

print("")
print("=== 测试完成 ===")
print("成功实现 kv-1>box 语义：通过节点 ID 定位到绑定的沙箱实例。")
