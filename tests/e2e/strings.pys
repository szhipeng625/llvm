s = "hello"
print(s)
print(s + " world")
print(s * 2)
print(len(s))
print(s[0], s[-1])
print(s[1:4])
print(s[::-1])
print(s.upper(), s.lower())
print(s.replace("l", "L"))
print(s.find("ll"), s.count("l"))
print(s.startswith("he"), s.endswith("lo"))
print("a,b,c".split(","))
print("-".join(["x", "y", "z"]))
print("  pad  ".strip())
print("abc" == "abc", "abc" == "abd", "abc" < "abd")
print("")
print("tab\there")
