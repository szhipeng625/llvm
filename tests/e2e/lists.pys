xs = [1, 2, 3]
print(xs, len(xs))
xs.append(4)
print(xs[0], xs[-1], xs[3])
xs[0] = 9
print(xs)
print(xs[1:3], xs[::-1])
ys = [5, 6]
print(xs + ys)
print(ys * 2)

total = 0
for x in xs:
    total = total + x
print(total)

for x in [10, 20, 30]:
    if x == 20:
        continue
    print(x)

xs.append(7)
xs.sort()
xs.reverse()
print(xs)
print(xs.pop(), xs)
